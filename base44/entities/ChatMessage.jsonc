{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "aiface_id": {
      "type": "string",
      "description": "Reference to the AIFace"
    },
    "owner_user_id": {
      "type": "string",
      "description": "User ID that created this message"
    },
    "owner_email": {
      "type": "string",
      "description": "Email that created this message"
    },
    "aiface_owner_user_id": {
      "type": "string",
      "description": "Owner of the AIFace at message creation time"
    },
    "aiface_owner_email": {
      "type": "string",
      "description": "Owner email of the AIFace at message creation time"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "content": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "description": "Groups messages into conversations"
    },
    "orchestration_mode": {
      "type": "string",
      "enum": [
        "direct",
        "orchestrated"
      ],
      "description": "Whether SnapTrainer answered directly or routed through specialist agents"
    },
    "orchestration_summary": {
      "type": "string",
      "description": "Short user-facing summary of the orchestration flow"
    },
    "collaboration_mode": {
      "type": "string",
      "enum": [
        "auto",
        "parallel",
        "sequential",
        "debate",
        "hierarchical",
        "broadcast",
        "direct_response",
        "sequential_workflow",
        "parallel_workflow",
        "dynamic_handoff",
        "reviewer_evaluator_loop"
      ],
      "description": "Specialist collaboration strategy selected by the orchestrator"
    },
    "workflow_type": {
      "type": "string",
      "description": "High-level workflow selected by the orchestrator"
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "sequential",
        "parallel",
        "hybrid",
        "debate",
        "hierarchical",
        "broadcast",
        "direct_response",
        "sequential_workflow",
        "parallel_workflow",
        "dynamic_handoff",
        "reviewer_evaluator_loop"
      ],
      "description": "Whether subtasks were planned as sequential, parallel, or hybrid work"
    },
    "intelligence_layer": {
      "type": "string",
      "description": "The single user-facing intelligence layer that returns the final response"
    },
    "selected_agents": {
      "type": "array",
      "description": "Agent IDs selected for this task",
      "items": {
        "type": "string"
      }
    },
    "lifecycle": {
      "type": "array",
      "description": "Intelligence lifecycle stages applied to this response",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "agent_trace": {
      "type": "array",
      "description": "Visible activity steps for the specialist agents used to answer",
      "items": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "agent_name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "lane": {
            "type": "string"
          },
          "execution": {
            "type": "string"
          },
          "stance": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capability": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "subtasks": {
      "type": "array",
      "description": "Task decomposition created for the response",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "execution": {
            "type": "string"
          },
          "lane": {
            "type": "string"
          },
          "stance": {
            "type": "string"
          },
          "lifecycle_stage": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "handoffs": {
      "type": "array",
      "description": "Context handoffs between subtasks",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "quality_gates": {
      "type": "array",
      "description": "Verification criteria applied before sending the response",
      "items": {
        "type": "string"
      }
    },
    "recovery_policy": {
      "type": "object",
      "description": "Retry, fallback and escalation rules used by the orchestration layer",
      "properties": {
        "retry": {
          "type": "string"
        },
        "fallback": {
          "type": "string"
        },
        "escalation": {
          "type": "string"
        }
      }
    },
    "proactive_insight_policy": {
      "type": "string",
      "description": "Policy for appending helpful proactive insight"
    },
    "run_state": {
      "type": "object",
      "description": "Structured blackboard run state for orchestration debugging and checkpoint restore"
    },
    "run_id": {
      "type": "string",
      "description": "SnapTrainer engine run identifier"
    },
    "current_stage": {
      "type": "string",
      "description": "Run lifecycle stage at message completion"
    },
    "final_output": {
      "type": "string",
      "description": "Validated final output from the engine"
    },
    "errors": {
      "type": "array",
      "description": "Structured errors recorded during the run",
      "items": {
        "type": "object"
      }
    },
    "clarification_needed": {
      "type": "boolean",
      "description": "Whether the engine determined that clarification is needed"
    },
    "telemetry_events": {
      "type": "array",
      "description": "Structured telemetry events emitted during the orchestration run",
      "items": {
        "type": "object"
      }
    },
    "evaluation_result": {
      "type": "object",
      "description": "Final evaluator scores for the assistant response"
    }
  },
  "required": [
    "aiface_id",
    "role",
    "content"
  ]
}