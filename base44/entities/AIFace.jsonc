{
  "name": "AIFace",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the AIFace agent"
    },
    "avatar_url": {
      "type": "string",
      "description": "Avatar image URL"
    },
    "model": {
      "type": "string",
      "enum": [
        "gpt_5_mini",
        "gemini_3_flash",
        "gpt_5_4",
        "claude_sonnet_4_6",
        "claude_opus_4_6"
      ],
      "description": "Selected AI model"
    },
    "role": {
      "type": "string",
      "description": "The user's intended role for this personal AI identity"
    },
    "owner_user_id": {
      "type": "string",
      "description": "User ID of the creator/owner"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the creator/owner"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "default": "private"
    },
    "shared_with_emails": {
      "type": "array",
      "description": "Emails that can access this AIFace",
      "items": {
        "type": "string"
      }
    },
    "shared_with_user_ids": {
      "type": "array",
      "description": "User IDs that can access this AIFace",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "building",
        "ready",
        "training"
      ],
      "default": "building"
    },
    "identity_prompt": {
      "type": "string",
      "description": "System prompt built from user uploads and preferences"
    },
    "style_preferences": {
      "type": "object",
      "description": "Style settings like tone, language, verbosity",
      "properties": {
        "tone": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "verbosity": {
          "type": "string",
          "enum": [
            "kort",
            "medium",
            "detaljeret"
          ]
        },
        "formality": {
          "type": "string",
          "enum": [
            "uformel",
            "neutral",
            "formel"
          ]
        },
        "role": {
          "type": "string"
        }
      }
    },
    "advanced_training": {
      "type": "object",
      "description": "Expert training configuration for advanced AI/ML users",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "mode": {
          "type": "string",
          "enum": [
            "guided",
            "strict",
            "experimental"
          ]
        },
        "training_objective": {
          "type": "string"
        },
        "system_directives": {
          "type": "string"
        },
        "output_contract": {
          "type": "string"
        },
        "negative_constraints": {
          "type": "string"
        },
        "few_shot_examples": {
          "type": "string"
        },
        "evaluation_criteria": {
          "type": "string"
        },
        "memory_policy": {
          "type": "string",
          "enum": [
            "minimal",
            "adaptive",
            "strict"
          ]
        },
        "context_strategy": {
          "type": "string",
          "enum": [
            "concise",
            "balanced",
            "deep"
          ]
        },
        "preferred_collaboration_mode": {
          "type": "string",
          "enum": [
            "auto",
            "parallel",
            "sequential",
            "debate",
            "hierarchical",
            "broadcast"
          ]
        },
        "specialist_routing_notes": {
          "type": "string"
        },
        "confidence_policy": {
          "type": "string",
          "enum": [
            "state_uncertainty",
            "ask_when_unclear",
            "cite_assumptions"
          ]
        }
      }
    },
    "knowledge_summary": {
      "type": "string",
      "description": "AI-generated summary of what the agent has learned"
    },
    "total_messages": {
      "type": "number",
      "default": 0
    },
    "total_files": {
      "type": "number",
      "default": 0
    },
    "feedback_score": {
      "type": "number",
      "default": 0,
      "description": "Accumulated adaptation score"
    }
  },
  "required": [
    "name",
    "model"
  ]
}