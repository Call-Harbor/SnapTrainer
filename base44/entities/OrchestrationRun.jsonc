{
  "name": "OrchestrationRun",
  "type": "object",
  "properties": {
    "aiface_id": {
      "type": "string",
      "description": "Reference to the AIFace"
    },
    "session_id": {
      "type": "string",
      "description": "Conversation session this run belongs to"
    },
    "user_id": {
      "type": "string",
      "description": "User identifier when available"
    },
    "run_id": {
      "type": "string",
      "description": "Stable run identifier from the SnapTrainer engine"
    },
    "user_goal": {
      "type": "string",
      "description": "Original user goal"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "executing",
        "evaluating",
        "recovering",
        "completed",
        "needs_clarification",
        "failed"
      ]
    },
    "current_stage": {
      "type": "string",
      "enum": [
        "plan",
        "execute",
        "evaluate"
      ],
      "description": "Current lifecycle stage"
    },
    "execution_mode": {
      "type": "string"
    },
    "interpreted_intent": {
      "type": "object"
    },
    "run_state": {
      "type": "object",
      "description": "Full blackboard state for checkpoint restore and future mission control"
    },
    "assigned_agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "final_output": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "clarification_needed": {
      "type": "boolean"
    },
    "telemetry_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evaluation_result": {
      "type": "object"
    }
  },
  "required": [
    "aiface_id",
    "run_id",
    "user_goal"
  ]
}
